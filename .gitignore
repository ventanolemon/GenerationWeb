# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node / фронтенд ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── .NET (web_layer) ─────────────────────────────────────────────────────────
bin/
obj/

# ── Данные запуска ───────────────────────────────────────────────────────────
# `resources/` — ПОСТАВКА (словари, звук, шаблон базы), она версионируется.
# `data/` — то, что запуск накопил у себя: рабочая база, созданная копией
# шаблона при первом старте (`const.ensure_data_dir`). Это состояние ОДНОЙ
# установки, у каждого своё; в истории ему делать нечего.
data/

# ── SQLite ───────────────────────────────────────────────────────────────────
# Файлы БД версионируются НАМЕРЕННО (resources/*.db — демо-наполнение для
# просмотра интерфейсов, см. scripts/seed_demo.py), а вот спутники WAL-режима
# — это временное состояние процесса, им в истории делать нечего.
*.db-wal
*.db-shm
*.db-journal
resources/*.db.bak-*

# ── Локальное окружение ──────────────────────────────────────────────────────
.env
.env.local
.claude/
.DS_Store
