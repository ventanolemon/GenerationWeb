# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node / фронтенд ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── .NET (web_layer) ─────────────────────────────────────────────────────────
bin/
obj/

# ── SQLite ───────────────────────────────────────────────────────────────────
# Файлы БД версионируются НАМЕРЕННО (resources/*.db — демо-наполнение для
# просмотра интерфейсов, см. scripts/seed_demo.py), а вот спутники WAL-режима
# — это временное состояние процесса, им в истории делать нечего.
*.db-wal
*.db-shm
*.db-journal
resources/*.db.bak-*

# ── Локальное окружение ──────────────────────────────────────────────────────
.env
.env.local
.claude/
.DS_Store
