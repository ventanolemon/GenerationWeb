# Настройки развёртывания. Скопировать в `.env` рядом и отредактировать:
#
#     cp .env.example .env
#
# `.env` в репозиторий НЕ коммитится (см. `.gitignore`) — там ключи.

# Порт, на котором контур виден снаружи.
PUBLIC_PORT=8080

# Адрес, по которому к установке приходит браузер. Идёт в список
# разрешённых origin'ов web_layer. За доменом и TLS — менять здесь.
PUBLIC_ORIGIN=http://localhost:8080

# ── Контур: чем генерировать задания ────────────────────────────────────
# mock     — предсказуемый ответ без сети и без денег (демо и тесты);
# anthropic — боевой провайдер, нужен ключ ниже И `pip install anthropic`
#            (в `requirements.txt` он закомментирован намеренно).
CONTOUR_PROVIDER=mock
ANTHROPIC_API_KEY=

# Очередь контура на Postgres вместо SQLite. Пусто — SQLite на общем томе.
# Нужен, как только воркеров больше одного: см. README, §«Куда это не годится».
CONTOUR_PG_DSN=

# ── Переходный режим, который лучше не включать ─────────────────────────
# 1 — служба принимает личность из заголовков `X-User-Id`/`X-User-Role`,
# которые пишет КЛИЕНТ. Роль в них не заверена: прислать `admin` может кто
# угодно. Режим оставлен для необновлённых десктопов и рабочей настройкой
# не является.
#
# Включение здесь само по себе ничего не даст: nginx эти заголовки срезает
# на входе. Чтобы режим заработал, придётся снять и там — то есть открыть
# дыру в двух местах сразу, осознанно.
GEN_TRUST_IDENTITY_HEADERS=0
